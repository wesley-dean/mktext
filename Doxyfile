# Doxyfile
#
# Doxygen configuration for the mktext Bash library.  The Makefile docs target
# consumes prepared documentation dependencies and generates the ADR landing page
# before invoking this configuration.

PROJECT_NAME           = "mktext"
PROJECT_BRIEF          = "Deterministic Bash text-substitution library"

OUTPUT_DIRECTORY       = doc/reference
CREATE_SUBDIRS         = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = .
GENERATE_LATEX         = NO
GENERATE_MAN            = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

INPUT                  = src/mktext.bash \
                         doc/adr
RECURSIVE              = NO
FILE_PATTERNS          = *.bash \
                         *.md

EXCLUDE                = tests \
                         vendor \
                         dist \
                         doc/adr/README.intro.md \
                         doc/adr/README.outro.md \
                         doc/adr/preflight-checklist.md
EXCLUDE_PATTERNS       = */tests/* \
                         */vendor/* \
                         */dist/*

EXTENSION_MAPPING      = bash=C++
FILTER_PATTERNS        = *.bash=vendor/doxygen-bash.awk

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES

OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = doc/adr/README.md

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
